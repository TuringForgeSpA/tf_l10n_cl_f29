<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: wizard/rcv_import_views.xml -->
<odoo>
    <record id="view_tf_l10n_cl_f29_rcv_import_form" model="ir.ui.view">
        <field name="name">tf_l10n_cl.f29.rcv.import.form</field>
        <field name="model">tf_l10n_cl.f29.rcv.import</field>
        <field name="arch" type="xml">
            <form string="Comparar con el RCV">
                <p>
                    En el sitio del SII, en <strong>Registro de Compras y Ventas</strong>, elige el período y
                    descarga el <strong>detalle</strong> de ventas y de compras. Carga uno o ambos archivos,
                    sin modificarlos.
                </p>
                <group>
                    <field name="f29_id"/>
                    <field name="sales_file" filename="sales_filename"/>
                    <field name="sales_filename" invisible="1"/>
                    <field name="purchases_file" filename="purchases_filename"/>
                    <field name="purchases_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Comparar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
